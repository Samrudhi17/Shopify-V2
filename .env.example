# Copy to .env and fill in real values. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#
# This single file configures BOTH ways of running the project:
#   * docker-compose (server)  — reads it automatically
#   * dotnet run / npm run dev — Program.cs loads it from the repo root
#
# Real environment variables always take precedence over this file, so a
# server's service manager or CI can override any value.

# --- Database (MySQL) ---
# DB_PASSWORD becomes the container's MYSQL_ROOT_PASSWORD and is used to build
# the API connection string. The DB_HOST/PORT/NAME/USER values are only needed
# when running the API outside Docker; compose sets the connection string itself.
DB_PASSWORD=ChangeMe_Str0ng!Pass
DB_HOST=localhost
DB_PORT=3306
DB_NAME=QRShopDb
DB_USER=root

# --- App ---
# Public origin of the site. Shop catalog URLs are built from this
# (e.g. https://yourdomain.com/mulchand). No trailing slash.
PUBLIC_BASE_URL=https://yourdomain.com

# Long random secret (>=32 chars). Generate: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Host port for the web container (use 8080 if Caddy/nginx fronts it).
WEB_PORT=80

# --- Firebase (public web config, baked into the frontend bundle) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The API verifies the ID tokens the client sends against this project. Google
# publishes the signing keys, so no service-account file is needed. Leave it
# unset and the API falls back to VITE_FIREBASE_PROJECT_ID above; set it only if
# the two ever need to differ. The API refuses to start without one of them.
FIREBASE_PROJECT_ID=

# --- Razorpay (subscription billing) ---
# Test keys: Dashboard -> Test Mode -> Account & Settings -> API Keys.
#
# The frontend needs no copy of the key id: /subscriptions/order returns it
# alongside the order, so there is exactly one place to change it.
#
# KEY_SECRET must stay on the server — it signs and verifies payments, so anyone
# holding it can forge a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI product descriptions ---
# One POST to Gemini's generateContent endpoint. Get a key (free tier, no card)
# from Google AI Studio: https://aistudio.google.com/apikey
#
# AI_MODEL accepts either a floating alias or a pinned version:
#   gemini-flash-latest  always the current Flash — never retired, but the
#                        wording it produces can change under you
#   gemini-3.6-flash     pinned; predictable output, needs updating when the
#                        version is eventually retired
#
# Leave AI_API_KEY empty and everything else still runs — only the Generate
# button reports that it is off. The key is server-side only and never reaches
# the browser.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
AI_MODEL=gemini-flash-latest

# Any long random string. Paste the SAME value into the webhook you create at
# Dashboard -> Settings -> Webhooks, pointed at
# https://yourdomain.com/api/webhooks/razorpay with the payment.captured and
# payment.failed events.
RAZORPAY_WEBHOOK_SECRET=
